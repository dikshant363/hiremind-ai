// HIREMIND AI — Prisma schema (SQLite)
// Entities support the core intelligence loop:
//   Resume + Job -> Candidate Intelligence -> Match -> Gaps
//   -> Adaptive Interview -> Evaluations -> Readiness -> Roadmap

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User accounts for real authentication & server-side authorization
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("user") // user | admin
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
}

// A single end-to-end analysis session (one resume + one target job + interview + readiness + roadmap).
model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional owner user for authenticated sessions
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot of inputs
  resumeText String
  jobTitle   String
  jobText    String

  // Candidate intelligence (JSON)
  candidateProfileJson String

  // Job intelligence (JSON)
  jobProfileJson String

  // Match result (JSON) — Prototype Job Match Index + breakdown
  matchJson String?

  // Skill gaps (JSON) — prioritized
  gapsJson String?

  // Interview state machine (JSON)
  interviewJson String?

  // Readiness (JSON) — Prototype Job Readiness Index
  readinessJson String?

  // Roadmap (JSON)
  roadmapJson String?

  // Demo flag — never disguise demo data as production data
  isDemo Boolean @default(false)

  status String @default("created") // created | analyzed | interviewed | completed
}

// Live Dynamic System Configuration for the Control Center (singleton record).
model SystemConfig {
  id                   String   @id @default("singleton")
  brandName            String   @default("HireMind AI")
  brandTagline         String   @default("Evidence-based job readiness · AI-assisted assessment")
  accentColor          String   @default("blue") // blue | indigo | violet | emerald | amber | rose
  defaultDifficulty    String   @default("auto") // auto | easy | medium | hard
  scoringWeightsJson   String?
  readinessWeightsJson String?
  featureFlagsJson     String?
  customTaxonomyJson   String?
  customRolesJson      String?
  updatedAt            DateTime @updatedAt
}

// Audit events for observability (no PII, no API keys, no full resume text).
model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  sessionId String?
  category  String // auth | ai | db | security | system | config
  action    String
  level     String // info | warn | error
  message   String
  metaJson  String?
}

