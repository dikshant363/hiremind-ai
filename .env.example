# ============================================================
# HIREMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# ------------------------------------------------------------
# 1. Database Connection (Managed Cloud PostgreSQL for Production)
# ------------------------------------------------------------
# Pooled connection string for serverless functions (Neon / Supabase):
DATABASE_URL="postgresql://neondb_owner:password@ep-dark-wind-ayo7zc7q-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations (Neon non-pooler):
DIRECT_URL="postgresql://neondb_owner:password@ep-dark-wind-ayo7zc7q.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------
# 2. Authentication Secret (HMAC & Session Security)
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-this-to-a-secure-random-64-character-hex-string"

# ------------------------------------------------------------
# 3. Application Environment & Port
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# 4. AI Provider Configuration (Google Gemini)
# ------------------------------------------------------------
# Provide a valid Google Gemini API key for live AI extraction and evaluation.
# Leave blank to use the built-in deterministic intelligence engine (offline fallback).
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# ------------------------------------------------------------
# 5. Debugging Options (Optional)
# ------------------------------------------------------------
DEBUG_SQL=false
