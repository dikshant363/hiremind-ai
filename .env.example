# ============================================================
# HIREMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Database Connection (Choose SQLite for local dev or PostgreSQL for cloud/Neon)
# Local SQLite:
DATABASE_URL="file:../db/custom.db"
# Cloud PostgreSQL (Neon / Supabase):
# DATABASE_URL="postgresql://user:password@endpoint.neon.tech/hiremind?sslmode=require"

# Server Authentication & Cryptographic Signature Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET="change-this-to-a-secure-random-64-character-hex-string"

# Application Port & Host
PORT=3000
NODE_ENV=development

# AI Provider Configuration (Leave key blank for built-in deterministic fallback mode)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# Optional Local SQL Debugging
DEBUG_SQL=false
